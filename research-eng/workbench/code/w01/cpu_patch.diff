+_MASKS = {}
+
+
+def windowed_attention(q, k, v, window):
+    """Causal attention over the last `window` tokens (CPU stand-in).
+
+    q, k, v are (B, T, heads, head_dim), as the FA3 call expects.
+    """
+    T = q.size(1)
+    if (window, T) not in _MASKS:
+        i = torch.arange(T)[:, None]
+        j = torch.arange(T)[None, :]
+        _MASKS[(window, T)] = (j <= i) & (j >= i - window)
+    q, k, v = (t.transpose(1, 2) for t in (q, k, v))
+    y = F.scaled_dot_product_attention(
+        q, k, v, attn_mask=_MASKS[(window, T)])
+    return y.transpose(1, 2)
 
